@model CreateWorkTaskRequest

@{
    ViewData["Title"] = "Assign Task";
}

<div class="w-[44pc] max-w-full mx-auto">
    <div class="mb-[1.5pc] flex items-center justify-between">
        <div>
            <a asp-action="ReviewQueue" class="text-[#687068] text-[13px] hover:text-[#18181b]">← Back to Task Review Queue</a>
            <h1 class="text-[28px] font-[700] mt-[4px]">Assign New Task</h1>
            <p class="text-[#687068]">Delegate operational assignments with deadlines and priorities.</p>
        </div>
        <a asp-action="ReviewQueue" class="border border-[#d4d4d8] rounded-[8px] px-[14px] py-[8px] font-[600] text-[#52525b] hover:bg-[#f4f4f5]">Back</a>
    </div>

    <div class="bg-white border border-[#e4e4e7] rounded-[10px] shadow p-[2pc]">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-[#dc2626] text-[13px] mb-[1pc]"></div>

            <div class="mb-[1.2pc]">
                <label asp-for="Title" class="block font-[600] text-[14px] mb-[4px]">Task Title</label>
                <input asp-for="Title" required placeholder="e.g. Prepare monthly department compliance report" class="w-full h-[2.8pc] border border-[#d4d4d8] rounded-[8px] px-[12px] text-[14px] focus:border-[#ef001f] focus:outline-none" />
                <span asp-validation-for="Title" class="text-[#dc2626] text-[12px]"></span>
            </div>

            <div class="mb-[1.2pc]">
                <label asp-for="Description" class="block font-[600] text-[14px] mb-[4px]">Task Description & Guidelines</label>
                <textarea asp-for="Description" rows="3" placeholder="Specify requirements, deliverables, and expectations..." class="w-full border border-[#d4d4d8] rounded-[8px] p-[10px] text-[14px] focus:border-[#ef001f] focus:outline-none"></textarea>
                <span asp-validation-for="Description" class="text-[#dc2626] text-[12px]"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-[1pc] mb-[1.2pc]">
                <div>
                    <label asp-for="Priority" class="block font-[600] text-[14px] mb-[4px]">Priority Level</label>
                    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TaskPriority>()" class="w-full h-[2.8pc] border border-[#d4d4d8] rounded-[8px] px-[12px] text-[14px] focus:border-[#ef001f] focus:outline-none bg-white"></select>
                    <span asp-validation-for="Priority" class="text-[#dc2626] text-[12px]"></span>
                </div>
                <div>
                    <label asp-for="DueDate" class="block font-[600] text-[14px] mb-[4px]">Due Date</label>
                    <input asp-for="DueDate" type="date" required value="@DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-dd")" class="w-full h-[2.8pc] border border-[#d4d4d8] rounded-[8px] px-[12px] text-[14px] focus:border-[#ef001f] focus:outline-none bg-white" />
                    <span asp-validation-for="DueDate" class="text-[#dc2626] text-[12px]"></span>
                </div>
            </div>

            <div class="mb-[1.5pc]">
                <label asp-for="AssignedEmployeeId" class="block font-[600] text-[14px] mb-[4px]">Assign To Staff</label>
                <select asp-for="AssignedEmployeeId" asp-items="ViewBag.Assignees" required class="w-full h-[2.8pc] border border-[#d4d4d8] rounded-[8px] px-[12px] text-[14px] focus:border-[#ef001f] focus:outline-none bg-white">
                    <option value="">-- Select Assignee --</option>
                </select>
                <span asp-validation-for="AssignedEmployeeId" class="text-[#dc2626] text-[12px]"></span>
            </div>

            <div class="flex items-center gap-[10px]">
                <button type="submit" class="bg-[#ef001f] text-white rounded-[8px] px-[18px] py-[10px] font-[600] hover:bg-[#c9001a]">Assign Task</button>
                <a asp-action="ReviewQueue" class="border border-[#d4d4d8] rounded-[8px] px-[16px] py-[10px] font-[600] text-[#52525b] hover:bg-[#f4f4f5]">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
