@model List<ExpenseClaimDto>

@{
    ViewData["Title"] = "My Expenses";
}

<div class="flex flex-wrap items-center justify-between gap-[10px] mb-[1.5pc]">
    <div>
        <h1 class="text-[28px] font-[700]">My Expenses</h1>
        <p class="text-[#687068] mt-[4px]">Track your reimbursement claims, attach receipts, and follow administrative approval status.</p>
    </div>
    <a asp-action="Create" class="bg-[#ef001f] text-white rounded-[8px] px-[17px] py-[9px] font-[600] text-[14px] hover:bg-[#c9001a] transition-colors">New Claim</a>
</div>

@if (Model is null || Model.Count == 0)
{
    <div class="bg-[#eff6ff] border border-[#bfdbfe] text-[#1e40af] rounded-[8px] p-[16px] text-[14px]">You have not submitted any expense claims yet.</div>
}
else
{
    <div class="bg-white border border-[#e4e4e7] rounded-[10px] shadow overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-[14px] min-w-[34pc]">
                <thead class="bg-[#f4f4f5]">
                    <tr>
                        <th class="text-left p-[12px] text-[13px] font-[600] text-[#52525b]">Claim Title</th>
                        <th class="text-left p-[12px] text-[13px] font-[600] text-[#52525b]">Total Amount</th>
                        <th class="text-left p-[12px] text-[13px] font-[600] text-[#52525b]">Status</th>
                        <th class="text-left p-[12px] text-[13px] font-[600] text-[#52525b]">Submitted Date</th>
                        <th class="text-right p-[12px] text-[13px] font-[600] text-[#52525b]">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in Model)
                    {
                        var badgeClass = x.Status switch
                        {
                            ExpenseClaimStatus.AdminApproved => "bg-[#dcfce7] text-[#15803d]",
                            ExpenseClaimStatus.AdminRejected => "bg-[#fee2e2] text-[#b91c1c]",
                            ExpenseClaimStatus.Submitted => "bg-[#fef3c7] text-[#92400e]",
                            _ => "bg-[#f4f4f5] text-[#52525b]"
                        };
                        <tr class="border-b border-[#e4e4e7] hover:bg-[#fafafa] transition-colors">
                            <td class="p-[12px] font-[600] whitespace-nowrap">@x.Title</td>
                            <td class="p-[12px] font-[600] whitespace-nowrap">@x.TotalAmount.ToString("C")</td>
                            <td class="p-[12px] whitespace-nowrap"><span class="@badgeClass rounded-[6px] px-[8px] py-[4px] text-[12px] font-[600]">@x.Status</span></td>
                            <td class="p-[12px] text-[#687068] whitespace-nowrap">@(x.SubmittedAt?.ToString("dd MMM yyyy") ?? "Draft")</td>
                            <td class="p-[12px] text-right whitespace-nowrap">
                                <a asp-action="Details" asp-route-id="@x.Id" class="border border-[#71717a] text-[#52525b] rounded-[6px] px-[10px] py-[5px] text-[12px] font-[600] hover:bg-[#f4f4f5] transition-colors">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
