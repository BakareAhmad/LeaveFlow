@{
    ViewData["Title"] = "Privacy";
}

<div class="w-[45pc] max-w-full mx-auto mt-[2pc] bg-white border border-[#e4e4e7] rounded-[10px] shadow p-[2pc]">
    <h1 class="text-[28px] font-[700]">Privacy and Account Data</h1>
    <p class="text-[#687068] mt-[1pc]">
        LeaveFlow stores the employee, department and account information needed to run leave, task, expense and performance workflows.
    </p>
    <p class="text-[#687068] mt-[1pc]">
        Passwords are stored as BCrypt hashes. Access to records and review queues is limited by role and department.
    </p>
    <p class="text-[#687068] mt-[1pc]">
        Receipts are stored outside the public web folder, while notifications and audit history are stored in the configured application database.
    </p>
</div>
