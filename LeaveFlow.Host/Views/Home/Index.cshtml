@model DashboardViewModel

@{
    ViewData["Title"] = Model.IsAuthenticated ? "Dashboard" : "Employee Operations";

    var isManager = !Model.IsSystemAdmin && User.IsInRole(RoleNames.Manager);

    var dashboardMessage = Model.IsSystemAdmin
        ? "See what's going on across the organization and review pending items."
        : isManager
            ? "Manage your department, track tasks and submit expense claims."
            : "Your leave, tasks and performance reviews are all in one place.";
}

@if (!Model.IsAuthenticated)
{
    <div class="w-[92%] max-w-[82pc] mx-auto">
        <section class="mt-[1pc] bg-white border border-[#e4e4e7] rounded-[10px] shadow p-[2.5pc] flex flex-wrap items-center gap-[3pc]">
            <div class="w-full flex-1 md:min-w-[19pc]">
                <p class="text-[#ef001f] text-[13px] font-[700] tracking-[1px]">EMPLOYEE OPERATIONS PORTAL</p>
                <h1 class="text-[42px] leading-[1.15] font-[700] mt-[12px]">Manage employee work in one place.</h1>
                <p class="text-[#687068] text-[17px] leading-[1.7] mt-[1pc] max-w-[40pc]">
                    Handle leave requests, department tasks, manager expense claims and performance reviews from the same dashboard.
                </p>
                <div class="flex flex-wrap gap-[10px] mt-[2pc]">
                    <a asp-controller="Auth" asp-action="Login" class="bg-[#ef001f] text-white rounded-[8px] px-[20px] py-[11px] font-[600] hover:bg-[#c9001a]">
                        Sign In
                    </a>
                    <a href="#modules" class="border border-[#d4d4d8] bg-white rounded-[8px] px-[20px] py-[11px] font-[600] text-[#3f3f46] hover:bg-[#f4f4f5]">
                        View Modules
                    </a>
                </div>
            </div>

            <div class="w-full flex-1 md:min-w-[19pc] bg-[#18181b] text-white rounded-[10px] p-[2pc]">
                <div class="flex items-center justify-between border-b border-[#3f3f46] pb-[1pc]">
                    <div>
                        <p class="text-[#a1a1aa] text-[12px]">WORKSPACE</p>
                        <h2 class="text-[22px] font-[700] mt-[4px]">Connected workflows</h2>
                    </div>
                    <img src="~/images/leaveflow-mark.png" alt="" class="w-[4.5pc] h-auto" />
                </div>

                <div class="mt-[1pc] flex flex-col gap-[10px]">
                    <div class="bg-[#27272a] rounded-[8px] p-[12px] flex items-center justify-between">
                        <span class="font-[600]">Leave request</span>
                        <span class="text-[#fda4af] text-[13px]">Request and review</span>
                    </div>
                    <div class="bg-[#27272a] rounded-[8px] p-[12px] flex items-center justify-between">
                        <span class="font-[600]">Department task</span>
                        <span class="text-[#93c5fd] text-[13px]">Assign and track</span>
                    </div>
                    <div class="bg-[#27272a] rounded-[8px] p-[12px] flex items-center justify-between">
                        <span class="font-[600]">Expense claim</span>
                        <span class="text-[#86efac] text-[13px]">Manager submission & Admin review</span>
                    </div>
                    <div class="bg-[#27272a] rounded-[8px] p-[12px] flex items-center justify-between">
                        <span class="font-[600]">Performance review</span>
                        <span class="text-[#fde68a] text-[13px]">System metrics & Department report</span>
                    </div>
                </div>
            </div>
        </section>

        <section id="modules" class="mt-[2.5pc]">
            <div class="mb-[1.2pc]">
                <p class="text-[#ef001f] text-[13px] font-[700]">WHAT YOU CAN DO</p>
                <h2 class="text-[29px] font-[700] mt-[5px]">Four main areas.</h2>
            </div>

            <div class="flex flex-wrap gap-[1pc]">
                <div class="flex-1 min-w-[15pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.4pc]">
                    <div class="h-[2.8pc] w-[2.8pc] rounded-[8px] bg-[#fff1f3] text-[#ef001f] flex items-center justify-center font-[700]">L</div>
                    <h3 class="text-[18px] font-[700] mt-[1pc]">Leave Management</h3>
                    <p class="text-[#687068] text-[14px] leading-[1.6] mt-[7px]">Apply for leave, check your balance, and approve requests from your team.</p>
                </div>

                <div class="flex-1 min-w-[15pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.4pc]">
                    <div class="h-[2.8pc] w-[2.8pc] rounded-[8px] bg-[#eff6ff] text-[#1d4ed8] flex items-center justify-center font-[700]">T</div>
                    <h3 class="text-[18px] font-[700] mt-[1pc]">Task Management</h3>
                    <p class="text-[#687068] text-[14px] leading-[1.6] mt-[7px]">Assign work to your department, record progress and review completed tasks.</p>
                </div>

                <div class="flex-1 min-w-[15pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.4pc]">
                    <div class="h-[2.8pc] w-[2.8pc] rounded-[8px] bg-[#f0fdf4] text-[#15803d] flex items-center justify-center font-[700]">$</div>
                    <h3 class="text-[18px] font-[700] mt-[1pc]">Manager Expenses</h3>
                    <p class="text-[#687068] text-[14px] leading-[1.6] mt-[7px]">Managers submit reimbursement claims and receipts for the Administrator to review.</p>
                </div>

                <div class="flex-1 min-w-[15pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.4pc]">
                    <div class="h-[2.8pc] w-[2.8pc] rounded-[8px] bg-[#fffbeb] text-[#a16207] flex items-center justify-center font-[700]">P</div>
                    <h3 class="text-[18px] font-[700] mt-[1pc]">Performance Appraisals</h3>
                    <p class="text-[#687068] text-[14px] leading-[1.6] mt-[7px]">System-tracked task and leave metrics, with manager comments and a department report.</p>
                </div>
            </div>
        </section>

        <section class="mt-[2pc] mb-[1pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.5pc] flex flex-wrap items-center justify-between gap-[1pc]">
            <div>
                <h2 class="text-[20px] font-[700]">Everything in one system</h2>
                <p class="text-[#687068] text-[14px] mt-[5px]">Role-based access, notifications, reports and audit history.</p>
            </div>
            <a asp-controller="Auth" asp-action="Login" class="text-[#ef001f] font-[700]">Sign in to get started →</a>
        </section>
    </div>
}
else
{
    <div>
        <section class="bg-[#18181b] text-white rounded-[10px] p-[2pc] flex flex-wrap items-center justify-between gap-[1pc]">
            <div>
                <p class="text-[#fda4af] text-[13px] font-[700]">@Model.Role WORKSPACE</p>
                <h1 class="text-[30px] font-[700] mt-[5px]">Welcome back, @Model.Name</h1>
                <p class="text-[#d4d4d8] mt-[8px]">@dashboardMessage</p>
            </div>
            <a asp-controller="Notification" asp-action="Index" class="bg-white text-[#18181b] rounded-[8px] px-[16px] py-[10px] font-[600]">
                Notifications <span class="ml-[6px] text-[#ef001f]">@Model.UnreadNotifications</span>
            </a>
        </section>

        @if (Model.HasEmployeeProfile)
        {
            <section class="mt-[2pc]">
                <div class="mb-[1pc]">
                    <h2 class="text-[23px] font-[700]">My Workspace</h2>
                    <p class="text-[#687068] text-[14px] mt-[4px]">Your current activity across all active modules.</p>
                </div>

                <div class="flex flex-wrap gap-[1pc]">
                    <a asp-controller="LeaveRequest" asp-action="Index" class="flex-1 min-w-[15pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.3pc] hover:bg-[#fffafa]">
                        <div class="flex items-start justify-between">
                            <div>
                                <p class="text-[#687068] text-[13px]">LEAVE</p>
                                <p class="text-[27px] font-[700] mt-[5px]">@Model.LeaveBalance days</p>
                            </div>
                            <span class="h-[2.5pc] w-[2.5pc] bg-[#fff1f3] text-[#ef001f] rounded-[8px] flex items-center justify-center font-[700]">L</span>
                        </div>
                        <p class="text-[#687068] text-[13px] mt-[1pc]">@Model.MyPendingLeaveRequests pending · @Model.MyApprovedLeaveRequests approved</p>
                    </a>

                    <a asp-controller="WorkTask" asp-action="Index" class="flex-1 min-w-[15pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.3pc] hover:bg-[#f8fbff]">
                        <div class="flex items-start justify-between">
                            <div>
                                <p class="text-[#687068] text-[13px]">TASKS</p>
                                <p class="text-[27px] font-[700] mt-[5px]">@Model.MyOpenTasks</p>
                            </div>
                            <span class="h-[2.5pc] w-[2.5pc] bg-[#eff6ff] text-[#1d4ed8] rounded-[8px] flex items-center justify-center font-[700]">T</span>
                        </div>
                        <p class="text-[#687068] text-[13px] mt-[1pc]">Open or awaiting acceptance</p>
                    </a>

                    @if (isManager)
                    {
                        <a asp-controller="ExpenseClaim" asp-action="Index" class="flex-1 min-w-[15pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.3pc] hover:bg-[#f8fff9]">
                            <div class="flex items-start justify-between">
                                <div>
                                    <p class="text-[#687068] text-[13px]">EXPENSES</p>
                                    <p class="text-[27px] font-[700] mt-[5px]">@Model.MyActiveExpenseClaims</p>
                                </div>
                                <span class="h-[2.5pc] w-[2.5pc] bg-[#f0fdf4] text-[#15803d] rounded-[8px] flex items-center justify-center font-[700]">$</span>
                            </div>
                            <p class="text-[#687068] text-[13px] mt-[1pc]">Draft or submitted for review</p>
                        </a>
                    }

                    @if (!isManager && !Model.IsSystemAdmin)
                    {
                        <a asp-controller="PerformanceReview" asp-action="MyReviews" class="flex-1 min-w-[15pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.3pc] hover:bg-[#fffdf7]">
                            <div class="flex items-start justify-between">
                                <div>
                                    <p class="text-[#687068] text-[13px]">PERFORMANCE</p>
                                    <p class="text-[27px] font-[700] mt-[5px]">@Model.MyOutstandingPerformanceReviews</p>
                                </div>
                                <span class="h-[2.5pc] w-[2.5pc] bg-[#fffbeb] text-[#a16207] rounded-[8px] flex items-center justify-center font-[700]">P</span>
                            </div>
                            <p class="text-[#687068] text-[13px] mt-[1pc]">Reviews across appraisal cycles</p>
                        </a>
                    }
                </div>
            </section>
        }

        @if (Model.CanReview)
        {
            <section class="mt-[2pc]">
                <div class="flex flex-wrap items-end justify-between gap-[10px] mb-[1pc]">
                    <div>
                        <h2 class="text-[23px] font-[700]">Items Waiting for Review</h2>
                        <p class="text-[#687068] text-[14px] mt-[4px]">
                            Pending approvals across the modules you manage.
                        </p>
                    </div>
                    <a asp-controller="Report" asp-action="Index" class="text-[#ef001f] font-[600]">View Reports →</a>
                </div>

                <div class="flex flex-wrap gap-[1pc]">
                    <a asp-controller="LeaveRequest" asp-action="Manage" class="flex-1 min-w-[13pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.2pc] hover:border-[#ef001f]">
                        <p class="text-[#687068] text-[13px]">LEAVE REQUESTS</p>
                        <p class="text-[27px] font-[700] mt-[5px]">@Model.LeaveRequestsToReview</p>
                        <p class="text-[#ef001f] text-[13px] mt-[8px]">Open queue →</p>
                    </a>
                    <a asp-controller="WorkTask" asp-action="ReviewQueue" class="flex-1 min-w-[13pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.2pc] hover:border-[#1d4ed8]">
                        <p class="text-[#687068] text-[13px]">COMPLETED TASKS</p>
                        <p class="text-[27px] font-[700] mt-[5px]">@Model.TasksToReview</p>
                        <p class="text-[#1d4ed8] text-[13px] mt-[8px]">Open queue →</p>
                    </a>
                    @if (Model.IsSystemAdmin)
                    {
                        <a asp-controller="ExpenseClaim" asp-action="ReviewQueue" class="flex-1 min-w-[13pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.2pc] hover:border-[#15803d]">
                            <p class="text-[#687068] text-[13px]">EXPENSE CLAIMS</p>
                            <p class="text-[27px] font-[700] mt-[5px]">@Model.ExpenseClaimsToReview</p>
                            <p class="text-[#15803d] text-[13px] mt-[8px]">Open queue →</p>
                        </a>
                    }
                    @if (isManager)
                    {
                        <a asp-controller="PerformanceReview" asp-action="ReviewQueue" class="flex-1 min-w-[13pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.2pc] hover:border-[#a16207]">
                            <p class="text-[#687068] text-[13px]">APPRAISALS</p>
                            <p class="text-[27px] font-[700] mt-[5px]">@Model.PerformanceReviewsToReview</p>
                            <p class="text-[#a16207] text-[13px] mt-[8px]">Open queue →</p>
                        </a>
                    }
                </div>
            </section>
        }

        @if (Model.IsSystemAdmin)
        {
            <section class="mt-[2pc]">
                <h2 class="text-[23px] font-[700] mb-[1pc]">Organisation</h2>
                <div class="flex flex-wrap gap-[1pc]">
                    <a asp-controller="Employee" asp-action="Index" class="flex-1 min-w-[14pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.3pc] hover:bg-[#fffafa]">
                        <p class="text-[#687068] text-[13px]">EMPLOYEES</p>
                        <p class="text-[28px] font-[700] mt-[5px]">@Model.TotalEmployees</p>
                    </a>
                    <a asp-controller="Department" asp-action="Index" class="flex-1 min-w-[14pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.3pc] hover:bg-[#fffafa]">
                        <p class="text-[#687068] text-[13px]">DEPARTMENTS</p>
                        <p class="text-[28px] font-[700] mt-[5px]">@Model.TotalDepartments</p>
                    </a>
                    <a asp-controller="LeaveType" asp-action="Index" class="flex-1 min-w-[14pc] bg-white border border-[#e4e4e7] rounded-[8px] p-[1.3pc] hover:bg-[#fffafa]">
                        <p class="text-[#687068] text-[13px]">LEAVE TYPES</p>
                        <p class="text-[28px] font-[700] mt-[5px]">@Model.TotalLeaveTypes</p>
                    </a>
                </div>
            </section>
        }

        <section class="mt-[2pc]">
            <h2 class="text-[23px] font-[700] mb-[1pc]">Quick Actions</h2>
            <div class="flex flex-wrap gap-[10px]">
                @if (!Model.IsSystemAdmin)
                {
                    <a asp-controller="LeaveRequest" asp-action="Apply" class="bg-white border border-[#e4e4e7] rounded-[8px] px-[16px] py-[11px] font-[600] hover:bg-[#fff1f3]">Apply for Leave</a>
                    @if (isManager)
                    {
                        <a asp-controller="ExpenseClaim" asp-action="Create" class="bg-white border border-[#e4e4e7] rounded-[8px] px-[16px] py-[11px] font-[600] hover:bg-[#f0fdf4]">New Expense Claim</a>
                    }
                    <a asp-controller="WorkTask" asp-action="Index" class="bg-white border border-[#e4e4e7] rounded-[8px] px-[16px] py-[11px] font-[600] hover:bg-[#eff6ff]">My Tasks</a>
                    @if (!isManager)
                    {
                        <a asp-controller="PerformanceReview" asp-action="MyReviews" class="bg-white border border-[#e4e4e7] rounded-[8px] px-[16px] py-[11px] font-[600] hover:bg-[#fffbeb]">My Performance</a>
                    }
                }

                @if (Model.CanReview)
                {
                    <a asp-controller="WorkTask" asp-action="Create" class="bg-[#ef001f] text-white rounded-[8px] px-[16px] py-[11px] font-[600] hover:bg-[#c9001a]">Assign Task</a>
                    <a asp-controller="Report" asp-action="Index" class="bg-white border border-[#e4e4e7] rounded-[8px] px-[16px] py-[11px] font-[600] hover:bg-[#f4f4f5]">Reports</a>
                }

                @if (Model.IsSystemAdmin)
                {
                    <a asp-controller="PerformanceReview" asp-action="Cycles" class="bg-white border border-[#e4e4e7] rounded-[8px] px-[16px] py-[11px] font-[600] hover:bg-[#fffbeb]">Review Cycles</a>
                    <a asp-controller="Audit" asp-action="Index" class="bg-white border border-[#e4e4e7] rounded-[8px] px-[16px] py-[11px] font-[600] hover:bg-[#f4f4f5]">Audit Log</a>
                }
            </div>
        </section>
    </div>
}
