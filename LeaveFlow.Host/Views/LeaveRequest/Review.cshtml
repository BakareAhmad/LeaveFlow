@model ReviewLeaveRequest

@{
    ViewData["Title"] = "Review Leave Request";
    var leaveRequest = ViewBag.LeaveRequest as LeaveRequestDto;
    var requestId = ViewContext.RouteData.Values["id"];
}

@if (leaveRequest is null)
{
    <div class="bg-[#fee2e2] border border-[#fca5a5] text-[#991b1b] rounded-[8px] p-[12px]">Leave request details could not be loaded.</div>
}
else
{
    <div class="w-[48pc] max-w-full mx-auto">
        <div class="mb-[1.5pc] flex items-center justify-between">
            <div>
                <a asp-action="Manage" class="text-[#687068] text-[13px] hover:text-[#18181b]">← Back to Leave Management</a>
                <h1 class="text-[28px] font-[700] mt-[4px]">Review Leave Request</h1>
                <p class="text-[#687068]">Review application details and determine the approval decision.</p>
            </div>
            <a asp-action="Manage" class="border border-[#d4d4d8] rounded-[8px] px-[14px] py-[8px] font-[600] text-[#52525b] hover:bg-[#f4f4f5]">Back</a>
        </div>

        <div class="bg-white border border-[#e4e4e7] rounded-[10px] shadow p-[2pc]">
            <div class="bg-[#f4f4f5] rounded-[8px] p-[1.2pc] mb-[1.5pc] space-y-[8px] text-[14px]">
                <div class="flex"><p class="font-[600] w-[11pc] text-[#52525b]">Employee:</p><p class="font-[600] text-[#18181b]">@leaveRequest.EmployeeName</p></div>
                <div class="flex"><p class="font-[600] w-[11pc] text-[#52525b]">Department:</p><p>@leaveRequest.Department</p></div>
                <div class="flex"><p class="font-[600] w-[11pc] text-[#52525b]">Leave Type:</p><p>@leaveRequest.LeaveType</p></div>
                <div class="flex"><p class="font-[600] w-[11pc] text-[#52525b]">Dates:</p><p>@leaveRequest.StartDate.ToString("dd MMM yyyy") – @leaveRequest.EndDate.ToString("dd MMM yyyy")</p></div>
                <div class="flex"><p class="font-[600] w-[11pc] text-[#52525b]">Weekdays:</p><p class="font-[600]">@leaveRequest.NumberOfDays days</p></div>
                <div class="flex"><p class="font-[600] w-[11pc] text-[#52525b]">Reason:</p><p class="text-[#3f3f46]">@leaveRequest.Reason</p></div>
            </div>

            <form asp-action="Review" asp-route-id="@requestId" method="post">
                <div asp-validation-summary="ModelOnly" class="text-[#dc2626] text-[13px] mb-[1pc]"></div>
                <div class="mb-[1.5pc]">
                    <label asp-for="ReviewComment" class="block font-[600] text-[14px] mb-[4px]">Review Comment / Justification</label>
                    <textarea asp-for="ReviewComment" rows="3" class="w-full border border-[#d4d4d8] rounded-[8px] p-[10px] text-[14px] focus:border-[#ef001f] focus:outline-none" placeholder="Add optional review feedback or mandatory rejection reason..." maxlength="500"></textarea>
                    <span asp-validation-for="ReviewComment" class="text-[#dc2626] text-[12px]"></span>
                </div>
                <div class="flex gap-[8px]">
                    <button type="submit" name="Status" value="@LeaveStatus.Approved" class="bg-[#16a34a] text-white rounded-[8px] px-[18px] py-[10px] font-[600] text-[14px] hover:bg-[#15803d] transition-colors">Approve Request</button>
                    <button type="submit" name="Status" value="@LeaveStatus.Rejected" class="bg-[#dc2626] text-white rounded-[8px] px-[18px] py-[10px] font-[600] text-[14px] hover:bg-[#b91c1c] transition-colors">Reject Request</button>
                    <a asp-action="Manage" class="border border-[#d4d4d8] rounded-[8px] px-[16px] py-[10px] font-[600] text-[#52525b] hover:bg-[#f4f4f5] transition-colors">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
