@model LeaveRequestDto

@{
    ViewData["Title"] = "Cancel Leave Request";
}

<div class="w-[42pc] max-w-full mx-auto">
    <div class="mb-[1.5pc] flex items-center justify-between">
        <div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="text-[#687068] text-[13px] hover:text-[#18181b]">← Back to Leave Details</a>
            <h1 class="text-[28px] font-[700] mt-[4px]">Cancel Leave Request</h1>
            <p class="text-[#687068]">Confirm cancellation of your pending leave application.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="border border-[#d4d4d8] rounded-[8px] px-[14px] py-[8px] font-[600] text-[#52525b] hover:bg-[#f4f4f5]">Back</a>
    </div>

    <div class="bg-white border border-[#e4e4e7] rounded-[10px] shadow p-[2pc]">
        <div class="bg-[#fff7ed] border border-[#fed7aa] text-[#9a3412] rounded-[8px] p-[12px] mb-[1.5pc] text-[14px]">
            Are you sure you want to cancel this pending leave request? This action cannot be undone.
        </div>

        <div class="bg-[#f4f4f5] rounded-[8px] p-[1.2pc] mb-[1.5pc] space-y-[8px] text-[14px]">
            <div class="flex"><p class="font-[600] w-[10pc] text-[#52525b]">Leave Type:</p><p class="font-[600] text-[#18181b]">@Model.LeaveType</p></div>
            <div class="flex"><p class="font-[600] w-[10pc] text-[#52525b]">Dates:</p><p>@Model.StartDate.ToString("dd MMM yyyy") – @Model.EndDate.ToString("dd MMM yyyy")</p></div>
            <div class="flex"><p class="font-[600] w-[10pc] text-[#52525b]">Weekdays:</p><p class="font-[600]">@Model.NumberOfDays days</p></div>
            <div class="flex"><p class="font-[600] w-[10pc] text-[#52525b]">Reason:</p><p class="text-[#3f3f46]">@Model.Reason</p></div>
        </div>

        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="flex gap-[10px]">
            <button type="submit" class="bg-[#dc2626] text-white rounded-[8px] px-[18px] py-[10px] font-[600] text-[14px] hover:bg-[#b91c1c] transition-colors">Cancel Request</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="border border-[#d4d4d8] rounded-[8px] px-[16px] py-[10px] font-[600] text-[#52525b] hover:bg-[#f4f4f5] transition-colors">Back</a>
        </form>
    </div>
</div>
