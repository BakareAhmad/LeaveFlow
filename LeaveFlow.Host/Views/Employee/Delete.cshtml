@model EmployeeDto

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="w-[42pc] max-w-full mx-auto">
    <div class="mb-[1.5pc] flex items-center justify-between">
        <div>
            <a asp-action="Index" class="text-[#687068] text-[13px] hover:text-[#18181b]">← Back to Employees</a>
            <h1 class="text-[28px] font-[700] mt-[4px]">Delete Employee</h1>
            <p class="text-[#687068]">Deactivate this employee account and user login access.</p>
        </div>
        <a asp-action="Index" class="border border-[#d4d4d8] rounded-[8px] px-[14px] py-[8px] font-[600] text-[#52525b] hover:bg-[#f4f4f5]">Back</a>
    </div>

    <div class="bg-white border border-[#e4e4e7] rounded-[10px] shadow p-[2pc]">
        <div class="bg-[#fff7ed] border border-[#fed7aa] text-[#9a3412] rounded-[8px] p-[12px] mb-[1.5pc] text-[14px]">
            Are you sure you want to delete this employee? This will permanently archive their record and disable their login.
        </div>

        <div class="bg-[#f4f4f5] rounded-[8px] p-[1.2pc] mb-[1.5pc] space-y-[8px] text-[14px]">
            <div class="flex"><p class="font-[600] w-[10pc] text-[#52525b]">Full Name:</p><p class="font-[600] text-[#18181b]">@Model.FirstName @Model.LastName</p></div>
            <div class="flex"><p class="font-[600] w-[10pc] text-[#52525b]">Email Address:</p><p class="text-[#3f3f46]">@Model.Email</p></div>
            <div class="flex"><p class="font-[600] w-[10pc] text-[#52525b]">Department:</p><p class="text-[#3f3f46]">@Model.Department</p></div>
            <div class="flex"><p class="font-[600] w-[10pc] text-[#52525b]">System Role:</p><p><span class="bg-[#e4e4e7] text-[#3f3f46] rounded-[6px] px-[8px] py-[2px] text-[12px] font-[600]">@Model.Role</span></p></div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="flex gap-[10px]">
            <button type="submit" class="bg-[#dc2626] text-white rounded-[8px] px-[18px] py-[10px] font-[600] text-[14px] hover:bg-[#b91c1c] transition-colors">Delete Employee</button>
            <a asp-action="Index" class="border border-[#d4d4d8] rounded-[8px] px-[16px] py-[10px] font-[600] text-[#52525b] hover:bg-[#f4f4f5] transition-colors">Cancel</a>
        </form>
    </div>
</div>
