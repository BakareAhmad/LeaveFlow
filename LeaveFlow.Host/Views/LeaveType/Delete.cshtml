@model LeaveTypeDto

@{
    ViewData["Title"] = "Delete Leave Type";
}

<div class="w-[42pc] max-w-full mx-auto">
    <div class="mb-[1.5pc] flex items-center justify-between">
        <div>
            <a asp-action="Index" class="text-[#687068] text-[13px] hover:text-[#18181b]">← Back to Leave Types</a>
            <h1 class="text-[28px] font-[700] mt-[4px]">Delete Leave Type</h1>
            <p class="text-[#687068]">Remove this leave category from the organization policy.</p>
        </div>
        <a asp-action="Index" class="border border-[#d4d4d8] rounded-[8px] px-[14px] py-[8px] font-[600] text-[#52525b] hover:bg-[#f4f4f5]">Back</a>
    </div>

    <div class="bg-white border border-[#e4e4e7] rounded-[10px] shadow p-[2pc]">
        <div class="bg-[#fff7ed] border border-[#fed7aa] text-[#9a3412] rounded-[8px] p-[12px] mb-[1.5pc] text-[14px]">
            Are you sure you want to delete this leave type? Active or historical requests referencing it will remain archived.
        </div>

        <div class="bg-[#f4f4f5] rounded-[8px] p-[1.2pc] mb-[1.5pc] space-y-[8px] text-[14px]">
            <div class="flex"><p class="font-[600] w-[10pc] text-[#52525b]">Name:</p><p class="font-[600] text-[#18181b]">@Model.Name</p></div>
            <div class="flex"><p class="font-[600] w-[10pc] text-[#52525b]">Maximum Days:</p><p class="font-[600]">@Model.MaximumDays days</p></div>
            <div class="flex"><p class="font-[600] w-[10pc] text-[#52525b]">Description:</p><p class="text-[#3f3f46]">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</p></div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="flex gap-[10px]">
            <button type="submit" class="bg-[#dc2626] text-white rounded-[8px] px-[18px] py-[10px] font-[600] text-[14px] hover:bg-[#b91c1c] transition-colors">Delete Leave Type</button>
            <a asp-action="Index" class="border border-[#d4d4d8] rounded-[8px] px-[16px] py-[10px] font-[600] text-[#52525b] hover:bg-[#f4f4f5] transition-colors">Cancel</a>
        </form>
    </div>
</div>
