@model ChangePasswordRequest

@{
    ViewData["Title"] = "Change Password";
}

<div class="w-[42pc] max-w-full mx-auto">
    <div class="mb-[1.5pc] flex items-center justify-between">
        <div>
            <a asp-controller="Home" asp-action="Index" class="text-[#687068] text-[13px] hover:text-[#18181b]">← Back to Dashboard</a>
            <h1 class="text-[28px] font-[700] mt-[4px]">Change Password</h1>
            <p class="text-[#687068]">Enter your current password and choose a secure new password.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="border border-[#d4d4d8] rounded-[8px] px-[14px] py-[8px] font-[600] text-[#52525b] hover:bg-[#f4f4f5]">Back</a>
    </div>

    <div class="bg-white border border-[#e4e4e7] rounded-[10px] shadow p-[2pc]">
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-[#dc2626] text-[13px] mb-[1pc]"></div>

            <div class="mb-[1.2pc]">
                <label asp-for="CurrentPassword" class="block font-[600] text-[14px] mb-[4px]">Current Password</label>
                <input asp-for="CurrentPassword" class="w-full h-[2.8pc] border border-[#d4d4d8] rounded-[8px] px-[12px] text-[14px] focus:border-[#ef001f] focus:outline-none" type="password" autocomplete="current-password" autofocus placeholder="••••••••" />
                <span asp-validation-for="CurrentPassword" class="text-[#dc2626] text-[12px]"></span>
            </div>

            <div class="mb-[1.2pc]">
                <label asp-for="NewPassword" class="block font-[600] text-[14px] mb-[4px]">New Password</label>
                <input asp-for="NewPassword" class="w-full h-[2.8pc] border border-[#d4d4d8] rounded-[8px] px-[12px] text-[14px] focus:border-[#ef001f] focus:outline-none" type="password" autocomplete="new-password" placeholder="••••••••" />
                <span asp-validation-for="NewPassword" class="text-[#dc2626] text-[12px]"></span>
            </div>

            <div class="mb-[1.5pc]">
                <label asp-for="ConfirmPassword" class="block font-[600] text-[14px] mb-[4px]">Confirm New Password</label>
                <input asp-for="ConfirmPassword" class="w-full h-[2.8pc] border border-[#d4d4d8] rounded-[8px] px-[12px] text-[14px] focus:border-[#ef001f] focus:outline-none" type="password" autocomplete="new-password" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-[#dc2626] text-[12px]"></span>
            </div>

            <div class="flex items-center gap-[10px]">
                <button type="submit" class="bg-[#ef001f] text-white rounded-[8px] px-[18px] py-[10px] font-[600] text-[14px] hover:bg-[#c9001a] transition-colors">Change Password</button>
                <a asp-controller="Home" asp-action="Index" class="border border-[#d4d4d8] rounded-[8px] px-[16px] py-[10px] font-[600] text-[#52525b] hover:bg-[#f4f4f5] transition-colors">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
